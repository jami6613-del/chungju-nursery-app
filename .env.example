VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Lv1 푸시 알림용 (Web Push VAPID 공개키, Supabase Edge Function에는 비공개키 설정)
VITE_VAPID_PUBLIC_KEY=

# Supabase Management API용 (선택 사항 — scripts/supabase-sql.mjs로 SQL 실행할 때만 필요)
# VITE_ 접두사 없으므로 클라이언트 번들에 노출되지 않음. GitHub에 절대 올리지 말 것.
# 발급: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

